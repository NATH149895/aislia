---
interface QA { q: string; a: string }
const { items } = Astro.props as { items: QA[] };
const ld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, '') } })),
};
---
<div class="faq">
  {items.map((i) => <details><summary>{i.q}</summary><div set:html={i.a} /></details>)}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
